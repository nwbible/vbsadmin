@model VBSAdmin.Models.ChildrenViewModels.ChildrenMapViewModel

@{
    ViewData["Title"] = "Registered Children Map";
}


<h2>Registered Children Map</h2>


<img src="http://maps.google.com/mapfiles/ms/icons/green-dot.png" />@Model.ChurchName
<img src="http://maps.google.com/mapfiles/ms/icons/red-dot.png" />Unchurched
<img src="http://maps.google.com/mapfiles/ms/icons/blue-dot.png" />Other Church
<p></p>
<div id="map" style="width:1200px;height:800px"></div>


@section scripts {

    <script>
        function initMap() {
            const markers = @Html.Raw(ViewBag.Markers ?? "[]");
            const map = new google.maps.Map(document.getElementById('map'), {
                center: { lat: 47.608013, lng: -122.335167 },
                zoom: 11,
                mapTypeId: 'roadmap'
            });

            const infoWindow = new google.maps.InfoWindow();
            const bounds = new google.maps.LatLngBounds();
            const markerList = [];

            if (Array.isArray(markers) && markers.length > 0) {
                markers.forEach(data => {
                    const position = { lat: parseFloat(data.lat), lng: parseFloat(data.lng) };
                    const marker = new google.maps.Marker({
                        position,
                        title: data.title,
                        icon: getMarkerIcon(data.homeChurch)
                    });

                    marker.addListener('click', () => {
                        infoWindow.setContent(data.description);
                        infoWindow.open(map, marker);
                    });

                    marker.setMap(map);
                    markerList.push(marker);
                    bounds.extend(position);
                });

                map.fitBounds(bounds);
            }

            // Use the official MarkerClustererPlus library for clustering.
            if (markerList.length > 0 && typeof MarkerClusterer === 'function') {
                new MarkerClusterer(map, markerList, {
                    imagePath: 'https://developers.google.com/maps/documentation/javascript/examples/markerclusterer/m',
                    minimumClusterSize: 5
                });
            }
        }

        function getMarkerIcon(homeChurch) {
            switch (homeChurch) {
                case 'home':
                    return 'https://maps.google.com/mapfiles/ms/icons/green-dot.png';
                case 'none':
                    return 'https://maps.google.com/mapfiles/ms/icons/red-dot.png';
                default:
                    return 'https://maps.google.com/mapfiles/ms/icons/blue-dot.png';
            }
        }
    </script>

    <script src="https://developers.google.com/maps/documentation/javascript/examples/markerclusterer/markerclusterer.js"></script>
    <script async defer
            src="https://maps.googleapis.com/maps/api/js?key=<INSERT GOOGLE API KEY HERE>&callback=initMap&v=weekly">
    </script>
}

